{
  "name": "@nav/web-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts --mock",
    "build": "tsup",
    "start": "node dist/index.js --mock",
    "dev:service": "node --env-file=../.env --watch --import tsx src/index.ts --service",
    "start:service": "node --env-file=../.env dist/index.js --service"
  },
  "dependencies": {
    "@nav/contracts": "*",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2"
  }
}
