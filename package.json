{
  "name": "nav-reconcile-engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "web-server",
    "web-app",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm run dev -w web-server\" \"npm run dev -w web-app\"",
    "build": "npm run build -w web-server && npm run build -w web-app",
    "typecheck": "tsc --noEmit -p packages/contracts && tsc --noEmit -p web-server && tsc --noEmit -p web-app",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write \"web-app/src/**/*.{ts,tsx,css}\" \"web-app/e2e/**/*.ts\" \"web-server/src/**/*.ts\" \"packages/contracts/src/**/*.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
